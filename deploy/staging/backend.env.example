###############################################################################
# DeDato staging backend env template
#
# Copy to deploy/staging/backend.env on the staging VPS and chmod 600.
# Never copy production values into this file. Keep values unquoted.
###############################################################################

ENVIRONMENT=staging

# Auth: replace this placeholder with a staging-only random value (32+ chars).
JWT_SECRET_KEY=CHANGE_ME_TO_A_STAGING_ONLY_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_SESSION_VERSION_REQUIRED=0
JWT_TOKEN_TYPE_REQUIRED=0

# Public staging origin.
FRONTEND_URL=https://test.dedato.ru
API_BASE_URL=https://test.dedato.ru

# Compose forces these staging-only endpoints as a second isolation guard.
DATABASE_URL=sqlite:////data/bookme.db
REDIS_HOST=redis
REDIS_PORT=6379

# Development-only routes/data stay disabled in staging.
ENABLE_DEV_TESTDATA=
DEV_E2E=

SALONS_ENABLED=
LEGACY_INDIE_MODE=0

# Email is network-disabled by default. Populate staging-only values before
# changing EMAIL_ENABLED to true.
EMAIL_ENABLED=false
EMAIL_PROVIDER=unisender
UNISENDER_API_KEY=
UNISENDER_LIST_ID=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DeDato Staging

# Payment calls are disabled by the stub. If explicitly enabled later, staging
# must remain in test mode and use test-only credentials.
ROBOKASSA_MODE=stub
ROBOKASSA_IS_TEST=true
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=
ROBOKASSA_RESULT_URL=https://test.dedato.ru/api/payments/robokassa/result
ROBOKASSA_SUCCESS_URL=https://test.dedato.ru/payment/success
ROBOKASSA_FAIL_URL=https://test.dedato.ru/payment/failed
ROBOKASSA_ALLOW_INSECURE_PROD_PASSWORDS_IN_TEST=false

# Telephony is network-disabled by default. Values, if enabled manually, must
# belong to staging/test accounts.
ZVONOK_MODE=stub
ZVONOK_API_KEY=
PLUSOFON_MODE=stub
PLUSOFON_USER_ID=
PLUSOFON_ACCESS_TOKEN=

# Yandex OAuth is disabled until staging-only credentials and redirect URI exist.
YANDEX_AUTH_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://test.dedato.ru/api/auth/oauth/callback

# Direct Apple IAP stays fail-closed until all staging credentials are supplied.
APPLE_IAP_ENABLED=false
APPLE_IAP_BUNDLE_ID=com.dedato.app
APPLE_IAP_APP_ID=CHANGE_ME_NUMERIC_APP_STORE_ID
APPLE_IAP_ISSUER_ID=CHANGE_ME
APPLE_IAP_KEY_ID=CHANGE_ME
APPLE_IAP_PRIVATE_KEY=CHANGE_ME_DO_NOT_COMMIT_REAL_PRIVATE_KEY
APPLE_IAP_ROOT_CERTS_PATH=/run/secrets/apple-root-certificates
